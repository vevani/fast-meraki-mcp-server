# Cisco Meraki MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your Meraki Dashboard API key
# Get this from: Dashboard > Organization > Settings > Dashboard API access
MERAKI_API_KEY=your_api_key_here

# Optional: Meraki API base URL (default: https://api.meraki.com/api/v1)
MERAKI_BASE_URL=https://api.meraki.com/api/v1

# Optional: HTTP request timeout in seconds (default: 30)
MERAKI_TIMEOUT=30

# Optional: Logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Log file path (default: logs/meraki_mcp.log)
LOG_FILE=logs/meraki_mcp.log