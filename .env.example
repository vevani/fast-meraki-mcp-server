# Fast Meraki MCP Server Environment Configuration
# Copy this file to .env and replace the placeholder values with your actual credentials

# Required: Cisco Meraki API Key
# Get your API key from: https://dashboard.meraki.com/api_access
MERAKI_API_KEY=your_meraki_api_key_here

# Optional: Server Configuration (defaults shown)
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=0.0.0.0
LOG_LEVEL=INFO
