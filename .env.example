# Meraki MCP Server v2 Configuration
# Copy this file to .env and fill in your values

# Required: Your Cisco Meraki API key
# Get one at: https://dashboard.meraki.com/api_access
MERAKI_API_KEY=your_api_key_here

# Optional: Server configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_SERVER_PATH=/mcp

# Optional: Logging configuration
LOG_LEVEL=INFO

# Optional: Performance tuning
MAX_CONNECTIONS=10
MAX_KEEPALIVE_CONNECTIONS=5
REQUEST_TIMEOUT=30

# Optional: Semantic discovery cache
DISCOVERY_CACHE_SIZE=100
DISCOVERY_CACHE_TTL=300

# Optional: Rate limiting (requests per second)
RATE_LIMIT=10
